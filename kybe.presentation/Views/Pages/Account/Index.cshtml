@{
    ViewData["Title"] = "Meu dados";
}
@{
    var name = User.FindFirst(
        System.Security.Claims.ClaimTypes.Name
    )?.Value;

    var lastName = User.FindFirst(
        System.Security.Claims.ClaimTypes.Surname
    )?.Value;

    var userName = User.FindFirst(
        "UserName"
    )?.Value;
}

<div class="inteface-conteiner">
    <div class="info-page">
        <span class="title tootips" data-title="▲ tela de dados do usuário">
            dados | meu dados
        </span>
    </div>
    <div class="inteface common-box">
        <partial name="~/Views/Shared/Partials/_NavUser.cshtml"/>

        <div class="common-box " style="height: 95%">
            <div class="common-flex-row common-box">
                <div class="common-flex-row common-lheight">
                    <div class="common-font-medium">
                        <span>@name @lastName</span>
                    </div>

                    <span class="common-font-small ">@@@userName</span>
                </div>
            </div>
        </div>
        
        
    </div>
</div>

<style>

    .common-flex-row{
        display: inline-flex;
        flex-direction: column;
    }

    .common-box{
        border: 1px solid #d3d3d3;
        box-shadow: 0px 0px 2px rgba(1, 1, 1, 0.1);
        padding: 15px;
        border-radius: 10px;
    }

    .common-font-small{
        display: inline-block;
        letter-spacing: 1px;
        font-size: 12px;
        font-weight: 300;
        cursor: pointer;
        transition: 0.3s all ease;
    }
    .common-font-medium{
        display: inline-block;
        letter-spacing: 1px;
        font-size: 14px;
        font-weight: 300;
        cursor: pointer;
        transition: 0.3s all ease;
    }
   
    .common-lheight{
        line-height: 15px
    }
    .common-font-small:hover, .common-font-medium:hover{
        transform: translateY(-1px)
    }
</style>