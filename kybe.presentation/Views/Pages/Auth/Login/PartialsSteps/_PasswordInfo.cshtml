@using kybe.presentation.ViewModels.Entity.User.Login
@model UserLoginVM

<div class="row inputs">
    <div class="col-md-5 mt-3 auth-conteiner-design">
        <partial name="~/Views/Pages/Auth/_Partials/_DesignLogin.cshtml" />

    </div>
    <div class="col-sm-7">
        
        <div class="auth-conteiner-input">
            <input type="password" placeholder=" " asp-for="Password" />
            <label for="password" class="auth-label">
                <span>
                    Senha
                </span>
            </label>
        </div>
        <span class="validation" asp-validation-for="Password"></span>
        <partial name="~/Views/Pages/Auth/_Partials/Common/_RecoveryAccess.cshtml" />
    </div>
</div>

<div class="row inputs">
    <div class="col-md-5 inputs auth-label-none" style="margin-top: 10px;">
        <span>Informe sua senha</span>
        
    </div>

</div>

<div class="row">
    
</div>
