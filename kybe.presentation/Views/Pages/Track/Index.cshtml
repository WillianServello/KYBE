@{
    ViewData["Title"] = "Tracks";
}

<div class="inteface-conteiner">
    <div class="info-page">
        <span class="title tootips" data-title="▲ tela de tracks">
            tracks | tool
        </span>
    </div>
    <div class="inteface">
        <partial name="~/Views/Shared/Partials/_NavUser.cshtml" />

        <div>
            <div class="upload-container">
                <!-- Ajustado o ID para "textarchive" e a classe para "text-archive" -->
                <span id="textarchive" class="text-archive">Nenhum arquivo selecionado</span>

                <input type="file" id="inputtrack" accept="audio/*" class="input-hidden">
                <label for="inputtrack" class="button-custom">
                    track
                </label>
            </div>

            <style>
                /* Esconde o input padrão sem quebrar a acessibilidade */
                .input-hidden {
                    width: 0.1px;
                    height: 0.1px;
                    opacity: 0;
                    overflow: hidden;
                    position: absolute;
                    z-index: -1;
                }

                /* Estiliza o Label para parecer um botão moderno */
                .button-custom {
                    display: inline-block;
                    padding: 10px 16px;
                    background: linear-gradient(360deg, #101010, #151c24, #1f2937);
                    color: white;
                    border-radius: 5px;
                    font-weight: 500;
                    cursor: pointer;
                    border: 1px solid #101010;
                    transition: 0.5s all ease;
                }

                    /* Efeito visual ao passar o mouse */
                    .button-custom:hover {
                        background: none;
                        color: black;
                    }

                /* Texto descritivo ao lado - Classe corrigida com hífen */
                .text-archive {
                    margin-right: 12px; /* Mudado para margin-right porque o texto vem ANTES do botão no seu HTML */
                    font-family: sans-serif;
                    color: #666;
                    font-size: 14px;
                }
            </style>
        </div>
    </div>
</div>

<script>
    const inputtrack = document.getElementById('inputtrack');
    const textarchive = document.getElementById('textarchive'); // Agora o ID coincide com o HTML

    inputtrack.addEventListener('change', function(event) {
        const archive = event.target.files[0];

        if (archive) {
            textarchive.textContent = archive.name;
        } else {
            textarchive.textContent = "Nenhum arquivo selecionado";
        }
    });
</script>