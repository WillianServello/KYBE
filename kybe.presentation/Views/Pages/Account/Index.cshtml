@using kybe.presentation.Extensions
@using kybe.presentation.ViewModels.Entity.Account.Components
@{
    ViewData["Title"] = "Meu dados";
}
@section Styles {
    <link rel="stylesheet" href="~/css/pages/account/account.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/account/components/privacy/privacy.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/account/media/media.css" asp-append-version="true" />
}

<div class="inteface-conteiner">
    <div class="info-page">
        <span class="title tootips" data-title="▲ tela de dados do usuário">
            dados | meus dados
        </span>
    </div>
    <div class="inteface">
        <partial name="~/Views/Shared/Partials/_NavUser.cshtml"/>

        <div class="common-box " style="height: 85vh">
            <div class="common-flex-column common-gap-medium w-100">
                <div class="common-flex-column common-lheight w-100">

                    <div class="common-align-center">
                        <div class="common-rpadding-medium">
                            <i class="bi bi-person fs-4"></i>
                        </div>
                        <div class="common-flex-column w-100">
                            <div class="common-font-medium">
                                <span>@User.GetName() @User.GetLastName()</span>
                            </div>

                            <div>
                                <span class="common-font-small ">@@@User.GetUserName()</span>
                            </div>
                        </div>
                    </div>
                    
                </div>

                <div class="account-page w-100 ">

                    @* MENU LATERAL - LEFT BAR *@
                    <div class="d-flex bar account-bar">
                        <a class="account-bar-itens" 
                           asp-action="Index"
                           asp-controller="Account"
                           asp-route-tab="mydata">
                            <div class="bar-icons">
                                <i class="bi bi-person fs-6"></i>
                            </div>
                            <span class="common-font-medium">Meus dados</span>
                        </a>

                        <a class="account-bar-itens"
                           asp-action="Index"
                           asp-controller="Account"
                           asp-route-tab="edit">
                            <div class="bar-icons">
                                <i class="bi bi-pencil fs-6"></i>
                            </div>
                            <span class="common-font-medium">Editar Dados</span>
                        </a>

                        <a class="account-bar-itens" 
                           asp-action="Index"
                           asp-controller="Account"
                           asp-route-tab="delete">
                            <div class="bar-icons">
                                <i class="bi bi-folder-minus fs-6"></i>
                            </div>
                            <span class="common-font-medium">Excluir Conta</span>
                        </a>

                        @if (User.IsInRole("Admin"))
                        {
                            <a class="account-bar-itens" 
                            asp-action="Index"
                            asp-controller="Account"
                            asp-route-tab="auditlog">
                                <div class="bar-icons">
                                    <i class="bi bi-app-indicator fs-6"></i>
                                </div>
                                <span class="common-font-medium">Auditoria</span>
                            </a>
                        }

                    </div>

                    @* CONTEÚDO DA _PARTIALS *@
                    <div class="account-content common-padding-medium w-100">
                        <div>
                            @switch (Model.ActiveTab)
                            {

                                case AccountTab.Delete:
                                    @await Component.InvokeAsync("Delete")
                                    break;

                                case AccountTab.Edit:
                                    @await Component.InvokeAsync("Edit")
                                    break;

                                case AccountTab.AuditLog:
                                    @if (User.IsInRole("Admin"))
                                    {
                                        @await Component.InvokeAsync("AuditLog")
                                        
                                    }
                                    break;

                                default:
                                    @await Component.InvokeAsync("MyData")
                                    break;
                            }
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>


