<div class="sidebar justify-content-between active" id="sidebar">
    <div class="sidebar-conteiner">

        <div class="sidebar-conteiner-button">
            <button class="sidebar-button-togle" onclick="toggleSidebar()">
                <i class="fa-solid fa-bars " id="sidebar-arrow"></i>
            </button>
        </div>

        <a class="sidebar-conteiner-itens sidebar-link"
           asp-controller="Home"
           asp-action="Index">

            <i class="fa-solid fa-house-chimney sidebar-icone "></i>
            <span class="fontPoppins">
                Home
            </span>

        </a>
    </div>
    <div>
        <hr style="margin-left: -20px; width: 100vh!important " />
        <form asp-controller="Auth" asp-action="Logout" method="post">
            @Html.AntiForgeryToken()
            <div class="w-100">
                <button type="submit" class="sidebar-conteiner-itens w-100 sidebar-link">
                    <i class="bi bi-box-arrow-in-right sidebar-icone"></i>
                    <span class="fontPoppins">Sair</span>
                </button>
            </div>
            
        </form>
    </div>
    
</div>