<style>
    .d-flex-hvh {
        display: flex;
        height: calc(100vh - 240px)
    }

    .privacy-edit {
        color: transparent;
        pointer-events: none;
        transition: 0.3s all ease;
    }

    .common-bookmark:hover .privacy-edit {
        color: black;
        pointer-events: auto;
        cursor: pointer;
    }

    .common-border-left {
        border-left: 1px solid #d3d3d3;
        height: 100%;
    }

    .privacy-icons {
        width: 30px !important;
    }

    .common-bookmark {
        position: relative;
        left: -15px;
        background: #fff;
        border: 1px solid #d3d3d3;
        padding: 10px 45px 10px 15px;
        display: inline-flex;
        align-items: center;
        border-top-right-radius: 5px;
        border-bottom-right-radius: 5px;
        width: 450px;
        border-right: none;
        border-left: none;
        overflow: hidden;
        gap: 10px;
        transition: 0.5s all ease;
    }

        .common-bookmark::after {
            content: "";
            position: absolute;
            right: 0;
            top: 50%;
            width: 25px;
            height: 25px;
            border-radius: 5px;
            background: #fff;
            transform: translate(50%, -50%) rotate(45deg);
            border-left: 1px solid #d3d3d3;
            border-bottom: 1px solid #d3d3d3;
        }
</style>