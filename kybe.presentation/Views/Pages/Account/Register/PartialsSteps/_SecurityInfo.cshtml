@using kybe.presentation.ViewModels.Entity.Account.Register
@model UserRegisterVM

<div class="row inputs">
    <div class="col-md-5 mt-3 auth-conteiner-design">
        <partial name="~/Views/Pages/Account/Register/_Partials/_DesignRegister.cshtml" />

    </div>
    <div class="col-md-7">

        <div class="auth-conteiner-input">
            <input type="text" placeholder=" " asp-for="UserName" required />
            <label for="lastName" class="auth-label">
                <span>
                    Usuário
                </span>
            </label>
        </div>
        <span class="validation" asp-validation-for="UserName"></span>
    </div>

</div>

<div class="row inputs">
    <div class="col-md-5 inputs auth-label-none">
        <span>Informe suas credências</span>
    </div>

    <div class="col-md-7 inputs">

        <div class="auth-conteiner-input">
            <input type="text" placeholder=" " asp-for="Password" />
            <label for="password" class="auth-label">
                <span>
                    Senha
                </span>
            </label>
        </div>
        <span class="validation" asp-validation-for="Password"></span>

    </div>

</div>
<div class="row inputs">
    <div class="col-md-5 inputs auth-label-none" >
    </div>
    <div class="col-md-7 inputs">

        <div class="auth-conteiner-input">
            <input type="text" placeholder=" " asp-for="PasswordConfirm" />
            <label for="confirmPassword" class="auth-label">
                <span>
                    Confirme a senha
                </span>
            </label>
        </div>
        <span class="validation" asp-validation-for="PasswordConfirm"></span>

    </div>

</div>
