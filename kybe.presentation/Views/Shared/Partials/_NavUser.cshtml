
<div class="nav">
    <div>
        <div class="account-page w-100 " style="position: relative !important;">

            @* MENU LATERAL - LEFT BAR *@
            <div class="d-flex topbar account-bar">
                <a class="account-topbar-itens"
                   asp-action="Index"
                   asp-controller="Home">
                    <div class="topbar-icons">
                        <i class="bi bi-house"></i>
                    </div>
                    <span class="common-font-medium">Home</span>
                </a>

            </div>
        </div>
    </div>
    <div class="home-conteiner-user">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="home-user" onclick="toggleMenuUser()">
                <div class="home-user-name tooltips-user" data-title-user="sessão usuário">
                    <span class="common-font-medium">
                        @User.Identity.Name
                    </span>
                </div>

                <div class="home-arrow-icon">
                    <i class="fa-solid fa-chevron-down" id="user-arrow"></i>
                </div>
            </div>

            <div class="home-user-menu" id="home-user-menu">
                <a class="home-item-menu" asp-action="Index" asp-controller="Account">
                    <i class="bi bi-person"></i>
                    <span class="common-font-medium">Perfil</span>
                </a>

                <div class="home-item-menu">
                    <i class="bi bi-bookmark"></i>
                    <span class="common-font-medium">Configurações</span>
                </div>

                <form asp-controller="Auth" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button class="home-item-menu w-100">
                        
                        <i class="bi bi-box-arrow-in-right"></i>
                        <span class="common-font-medium">Sair</span>
                    </button>
                </form>
            </div>

        }
        else
        {
            <div class="home-user" onclick="toggleMenuUser()">
           
                <div class="home-user-name tooltips-user" >
                    <span class="class="common-font-medium"">
                        Opções
                    </span>
                </div>

                <div class="home-arrow-icon">
                    <i class="fa-solid fa-chevron-down" id="user-arrow"></i>
                </div>
            </div>

            <div class="home-user-menu" id="home-user-menu">
                <a class="home-item-menu" asp-action="Login" asp-controller="Auth">
                    <i class="bi bi-plug-fill"></i>
                    <span>Login</span>
                </a>

                <a class="home-item-menu common-font-medium" asp-action="Register" asp-controller="Account">
                    <i class="bi bi-person-square"></i>
                    <span>Registrar</span>
                </a>
            </div>
        }
    </div>
</div>


@section Styles {
}