@using kybe.presentation.ViewModels.Entity.User
@using kybe.presentation.ViewModels.Entity.User.Register
@model UserViewModel
@{
    Layout = "~/Views/Shared/Layout/_AuthLayout.cshtml";
    ViewData["Title"] = "Cadastrar";
}

<form asp-controller="Auth" asp-action="Register" method="post">
    <div class="auth " >
        <div class="auth-border auth-border-lg" >
            <div class="auth-conteiner-image">
                <img class="auth-image" src="/img/kzbe-logo.png" />
            </div>
             
            <div class="row inputs" styles="flex-direction: column!important">
                <div class="col-md-5 mt-3" styles="flex-direction: column!important">
                    <span class="auth-create-design"  style="font-size: 28px; display: block">Crie sua Conta</span>
                    <span class="auth-create-design" style="font-size: 28px; opacity: 55%; display: block ">Crie sua Conta</span>
                    <span class="auth-create-design" style="font-size: 28px; opacity: 35%;">Crie sua Conta</span>
                </div>
                <div class="col-md-7">
                    <label for="lastName" class="auth-label">
                        <span>
                            Nome
                        </span>
                    </label>

                    <div class="auth-conteiner-input">
                        <input type="text" placeholder="Informe seu nome" asp-for="Name"/>
                    </div>
                    <span class="validation" asp-validation-for="Name"></span>
                </div>
                
            </div>

            <div class="row">
                <div class="col-md-5 inputs d-none-media">
                    
                </div>

                <div class="col-md-7 inputs">
                    <label for="cpf" class="auth-label">
                        <span>
                            Sobrenome(opcional)
                        </span>
                    </label>

                    <div class="auth-conteiner-input">
                        <input type="text" placeholder="Informe seu sobrenome" asp-for="LastName"/>
                    </div>
                    <span class="validation" asp-validation-for="LastName"></span>
                    
                </div>
            
            </div>
           

            <div class="row mt-2 mb-3">
                <div class="col-sm-12">
                    <hr class="m-auto" />
                </div>
            </div>

            
            
            <div class="row mt-auto">
                <div class="col-sm-8 auth-conteiner-register">
                    <span>
                        ja possui conta?
                    </span>

                    <a class="auth-button-register" asp-action="Login" asp-controller="Auth">
                        clique aqui
                    </a>
                </div>

                <div class="col-sm-4 auth-button-sign">
                    <button type="submit">
                        Cadastrar
                    </button>
                </div>
            </div>
        </div>
    </div>
    
</form>


