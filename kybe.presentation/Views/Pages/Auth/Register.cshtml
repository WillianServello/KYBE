@using kybe.presentation.ViewModels.Entity
@model UserViewModel
@{
    Layout = "~/Views/Shared/Layout/_AuthLayout.cshtml";
    ViewData["Title"] = "Cadastrar";
}

<form asp-controller="Auth" asp-action="Register" method="post">
    <div class="auth">
        <div class="auth-border auth-border-lg">
            <div class="auth-conteiner-image">
                <img class="auth-image" src="/img/kzbe-logo.png" />
            </div>

            <div class="row inputs">
                <div class="col-sm-12">
                    <label for="name" class="auth-label">
                        <span>
                            Nome
                        </span>
                    </label>

                    <div class="auth-conteiner-input">
                        <input type="text" placeholder="Informe seu nome" asp-for="Name"/>
                    </div>
                    <span class="validation" asp-validation-for="Name"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-sm-6 inputs">
                    <label for="email" class="auth-label">
                        <span>
                            Email
                        </span>
                    </label>

                    <div class="auth-conteiner-input">
                        <input type="email" placeholder="Informe seu email" asp-for="Email" />
                    </div>
                    <span class="validation" asp-validation-for="Email"></span>
                </div>

                <div class="col-sm-6 inputs">
                    <label for="cpf" class="auth-label">
                        <span>
                            CPF
                        </span>
                    </label>

                    <div class="auth-conteiner-input">
                        <input type="text" placeholder="Informe seu CPF" asp-for="Cpf"/>
                    </div>
                    <span class="validation" asp-validation-for="Cpf"></span>
                </div>
            </div>

            <div class="row mt-2 mb-3">
                <div class="col-sm-12" style="letter-spacing: 0.5px; line-height: 13px;">
                    <i class="fa-solid fa-key" style="font-size: 12px; padding-left: 5px;"></i>
                    <span style="font-size: 12px;">crendênciais</span>
                    <hr class="m-auto" />
                </div>
            </div>

            <div class="row inputs">
                <div class="col-sm-12">
                    <label for="user" class="auth-label">
                        <span>
                            Usuário
                        </span>
                    </label>

                    <div class="auth-conteiner-input">
                        <input type="text" placeholder="Informe seu usuário" asp-for="UserName" />
                    </div>
                    <span class="validation" asp-validation-for="UserName"></span>
                </div>

                
            </div>
            <div class="row">
                <div class="col-sm-6">
                    <label for="password" class="auth-label">
                        <span>
                            Senha
                        </span>
                    </label>

                    <div class="auth-conteiner-input">
                        <input type="password" placeholder="Informe a senha" asp-for="Password" />
                    </div>
                    <span class="validation" asp-validation-for="Password"></span>
                </div>

                <div class="col-sm-6">
                    <label for="password" class="auth-label">
                        <span>
                            Confirmação da Senha
                        </span>
                    </label>

                    <div class="auth-conteiner-input">
                        <input type="password" placeholder="Informe a senha" asp-for="PasswordConfirm" />
                    </div>
                    <span class="validation" asp-validation-for="PasswordConfirm"></span>
                </div>
            </div>

            <div class="row mt-auto">
                <div class="col-sm-8 auth-conteiner-register">
                    <span>
                        ja possui conta?
                    </span>

                    <a class="auth-button-register" asp-action="Login" asp-controller="Auth">
                        clique aqui
                    </a>
                </div>

                <div class="col-sm-4 auth-button-sign">
                    <button type="submit">
                        Cadastrar
                    </button>
                </div>
            </div>
        </div>
    </div>
</form>


