@if (TempData["Error"] != null)
{
    <div class="alert common-alert common-alert-error alert-dismissible fade show">
        <div>
            @TempData["Error"]
        </div>

                
        <div>
            <button type="button"
                    class="button-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

    </div>
}