@using kybe.presentation.ViewModels.Entity.User.Register
@model UserViewModel

<div class="row inputs">
    <div class="col-md-5 mt-3 auth-conteiner-design">
        <partial name="~/Views/Pages/Auth/_Partials/_DesignRegister.cshtml" />

    </div>
    <div class="col-md-3">
       

        <div class="auth-conteiner-input">
            <input type="text" placeholder=" " asp-for="PhoneNumber" />
            <label for="phoneNumber" class="auth-label">
                <span>
                    Telefone
                </span>
            </label>
        </div>
        <span class="validation" asp-validation-for="PhoneNumber"></span>
    </div>
    
    <div class="col-md-4">
        

        <div class="auth-conteiner-input">
            <input type="text" placeholder=" " asp-for="Cpf" />
            <label for="cpf" class="auth-label">
                <span>
                    CPF
                </span>
            </label>
        </div>
        <span class="validation" asp-validation-for="Cpf"></span>
    </div>

</div>

<div class="row inputs">
    <div class="col-md-5 inputs auth-label-none" style="margin-top: 10px;">
        <span>Informe seus dados de contato</span>
    </div>

    <div class="col-md-7 inputs">

        <div class="auth-conteiner-input">
            <input type="text" placeholder=" " asp-for="Email" />
            <label for="email" class="auth-label">
                <span>
                    Email
                </span>
            </label>
        </div>
        <span class="validation" asp-validation-for="Email"></span>

    </div>

</div>
